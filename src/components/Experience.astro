---
import Badge from "./Badge.astro";
import Section from "./Section.astro";
import type { Lang } from "../data/types";
import { homeContent, homeSection } from "../lib/home";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const section = homeSection(lang, "experience");
const { experience } = homeContent(lang);
---

{
  section && (
    <Section section={section}>
      <ol class="tl">
        {experience.map((e) => (
          <li class:list={["tl__item", e.current && "is-current"]}>
            <p class="tl__date">{e.period}</p>
            <div class="tl__rail" aria-hidden="true" />
            <div class="tl__body">
              <div class="tl__head">
                <h3 class="tl__role">{e.role}</h3>
                {e.current && <Badge lang={lang} kind="current" />}
                {e.draft && <Badge lang={lang} kind="draft" />}
              </div>
              <p class="tl__company">{e.company}</p>
              {e.bullets.length > 0 && (
                <ul class="tl__bullets">
                  {e.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ol>
    </Section>
  )
}

<style>
  .tl {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tl__item {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    grid-template-areas:
      "rail date"
      "rail body";
    column-gap: var(--space-4);
  }

  .tl__date {
    grid-area: date;
    margin: 0 0 var(--space-2);
    font-family: var(--mono);
    font-size: 12.5px;
    font-weight: 500;
    line-height: 20px;
    color: var(--text-muted);
  }

  .tl__rail {
    grid-area: rail;
    position: relative;
  }

  /* La linea verticale unisce i punti: parte dal primo e si ferma all'ultimo. */
  .tl__rail::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    transform: translateX(-0.5px);
    background: var(--border-strong);
  }

  .tl__item:first-child .tl__rail::before {
    top: 10px;
  }

  .tl__item:last-child .tl__rail::before {
    bottom: auto;
    height: 10px;
  }

  .tl__item:only-child .tl__rail::before {
    display: none;
  }

  .tl__rail::after {
    content: "";
    position: absolute;
    top: 4px;
    left: 50%;
    width: 12px;
    height: 12px;
    margin-left: -6px;
    border: 2px solid var(--border-strong);
    border-radius: 50%;
    background: var(--bg);
  }

  .is-current .tl__rail::after {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .tl__body {
    grid-area: body;
    padding-bottom: var(--space-12);
  }

  .tl__item:last-child .tl__body {
    padding-bottom: 0;
  }

  .tl__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .tl__role {
    margin: 0;
    font-size: 19px;
    font-weight: 600;
    line-height: 28px;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .tl__company {
    margin: 2px 0 var(--space-4);
    font-size: 15px;
    font-weight: 500;
    color: var(--text-muted);
  }

  .tl__bullets {
    display: grid;
    gap: var(--space-2);
    max-width: 68ch;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tl__bullets li {
    position: relative;
    padding-left: var(--space-5);
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text-body);
  }

  .tl__bullets li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.82em;
    width: 7px;
    height: 1px;
    background: var(--text-subtle);
  }

  @media (min-width: 768px) {
    .tl__item {
      grid-template-columns: 128px 24px minmax(0, 1fr);
      grid-template-areas: "date rail body";
      column-gap: var(--space-5);
    }

    .tl__date {
      margin: 0;
      line-height: 28px;
      text-align: right;
    }

    .tl__rail::after {
      top: 8px;
    }

    .tl__item:first-child .tl__rail::before {
      top: 14px;
    }

    .tl__item:last-child .tl__rail::before {
      height: 14px;
    }
  }
</style>
