---
import Badge from "./Badge.astro";
import Icon from "./Icon.astro";
import Section from "./Section.astro";
import { content, projectPath } from "../data";
import type { Lang } from "../data/types";
import { homeContent, homeSection } from "../lib/home";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { ui } = content[lang];
const section = homeSection(lang, "projects");
const { projects } = homeContent(lang);
---

{
  section && (
    <Section section={section}>
      <ul class="cards">
        {projects.map((p) => {
          const titleId = `${section.id}-${p.slug}`;
          return (
            <li class="card">
              <article class="card__body" aria-labelledby={titleId}>
                <h3 class="card__title" id={titleId}>
                  {p.name}
                </h3>
                <p class="card__meta">
                  <span>{p.kind}</span>
                  {p.draft && <Badge lang={lang} kind="draft" />}
                </p>
                <p class="card__summary">{p.summary}</p>
                {p.tags.length > 0 && (
                  <ul class="tags card__tags" aria-label={ui.technologies}>
                    {p.tags.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                )}
                {p.detail && (
                  <a class="card__link" href={projectPath(lang, p.slug)} aria-label={`${ui.details}: ${p.name}`}>
                    {ui.details}
                    <span class="card__arrow">
                      <Icon name="arrowRight" size={16} />
                    </span>
                  </a>
                )}
              </article>
            </li>
          );
        })}
      </ul>
    </Section>
  )
}

<style>
  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    transition: border-color 0.15s ease;
  }

  .card:hover {
    border-color: var(--border-strong);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .card__title {
    margin: 0;
    font-size: 19px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-2) 0 var(--space-3);
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-subtle);
  }

  .card__summary {
    margin: 0 0 var(--space-5);
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .card__tags {
    margin-bottom: var(--space-6);
  }

  .card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    align-self: flex-start;
    margin-top: auto;
    padding: var(--space-1) 0;
    border-radius: var(--radius-sm);
    font-size: 14.5px;
    font-weight: 600;
    color: var(--accent-text);
    transition: color 0.15s ease;
  }

  .card__link:hover {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .card__arrow {
    display: inline-flex;
    transition: transform 0.15s ease;
  }

  .card__link:hover .card__arrow {
    transform: translateX(2px);
  }

  @media (min-width: 768px) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }
</style>
