---
import Badge from "./Badge.astro";
import Section from "./Section.astro";
import { content } from "../data";
import type { Lang } from "../data/types";
import { homeSection } from "../lib/home";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { education } = content[lang];
const section = homeSection(lang, "education");
---

{
  section && (
    <Section section={section}>
      <ol class="edu">
        {education.map((ed) => (
          <li class="edu__row">
            <p class="edu__period">{ed.period}</p>
            <div class="edu__main">
              <h3 class="edu__degree">{ed.degree}</h3>
              <p class="edu__school">{ed.school}</p>
            </div>
            {ed.current && (
              <div class="edu__badge">
                <Badge lang={lang} kind="current" />
              </div>
            )}
          </li>
        ))}
      </ol>
    </Section>
  )
}

<style>
  .edu {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .edu__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--border);
  }

  .edu__period {
    margin: 0;
    font-family: var(--mono);
    font-size: 12.5px;
    font-weight: 500;
    line-height: 20px;
    color: var(--text-muted);
  }

  .edu__degree {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    line-height: 28px;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .edu__school {
    margin: 2px 0 0;
    font-size: 15px;
    color: var(--text-muted);
  }

  .edu__badge {
    justify-self: start;
    margin-top: var(--space-1);
  }

  @media (min-width: 768px) {
    .edu__row {
      grid-template-columns: 128px minmax(0, 1fr) auto;
      column-gap: var(--space-16);
      align-items: start;
    }

    .edu__period {
      line-height: 28px;
    }

    .edu__badge {
      justify-self: end;
      margin-top: 3px;
    }
  }
</style>
