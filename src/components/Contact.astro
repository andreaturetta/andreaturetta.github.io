---
import BreakText from "./BreakText.astro";
import CVButton from "./CVButton.astro";
import Icon from "./Icon.astro";
import { content } from "../data";
import type { Lang } from "../data/types";
import { homeSection } from "../lib/home";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { contact, ui } = content[lang];
const section = homeSection(lang, "contact");
const titleId = section ? `${section.id}-title` : "";
---

{
  section && (
    <section id={section.id} data-section={section.key} class="section" aria-labelledby={titleId}>
      <div class="wrap">
        <div class="contact">
          <div class="contact__head">
            <span class="sec-index" aria-hidden="true">
              {section.index}
            </span>
            <h2 id={titleId} class="contact__title">
              {ui.contactTitle}
            </h2>
          </div>
          <p class="contact__lead">{ui.contactLead}</p>
          <dl class="contact__list">
            <div class="contact__row">
              <dt>{ui.email}</dt>
              <dd>
                <a class="contact__email" href={`mailto:${contact.email}`}><BreakText text={contact.email} /></a>
              </dd>
            </div>
            <div class="contact__row">
              <dt>{ui.linkedin}</dt>
              <dd>
                <a class="contact__link" href={contact.linkedin} target="_blank" rel="noopener noreferrer">
                  <span><BreakText text={contact.linkedinLabel} /></span>
                  <Icon name="external" size={16} />
                  <span class="sr-only">{` ${ui.opensInNewTab}`}</span>
                </a>
              </dd>
            </div>
            <div class="contact__row">
              <dt>{ui.cvRow}</dt>
              <dd>
                <CVButton lang={lang} />
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </section>
  )
}

<style>
  .contact {
    padding: clamp(var(--space-5), 5vw, var(--space-16));
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--surface);
  }

  .contact__head {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
  }

  .contact__title {
    margin: 0 0 var(--space-4);
    font-size: clamp(40px, 7vw, 72px);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--text);
  }

  .contact__lead {
    max-width: 52ch;
    margin: 0 0 clamp(var(--space-8), 4vw, var(--space-12));
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .contact__list {
    margin: 0;
  }

  .contact__row {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--border);
  }

  .contact__row:last-child {
    padding-bottom: 0;
  }

  .contact__row dt {
    font-family: var(--mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  .contact__row dd {
    margin: 0;
    min-width: 0;
  }

  .contact__email {
    display: inline-block;
    max-width: 100%;
    border-radius: var(--radius-sm);
    font-size: clamp(19px, 4.2vw, 36px);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
    transition: color 0.15s ease;
  }

  .contact__email:hover {
    color: var(--accent-text);
  }

  .contact__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    max-width: 100%;
    min-height: 32px;
    border-radius: var(--radius-sm);
    font-size: 17px;
    font-weight: 500;
    color: var(--text);
    transition: color 0.15s ease;
  }

  .contact__link:hover {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (min-width: 768px) {
    .contact__row {
      grid-template-columns: 140px minmax(0, 1fr);
      align-items: center;
      gap: var(--space-6);
    }
  }
</style>
