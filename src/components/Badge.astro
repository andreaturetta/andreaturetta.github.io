---
import { content } from "../data";
import type { Lang } from "../data/types";

interface Props {
  lang: Lang;
  /** `current` = in corso; `draft` = bozza, visibile solo in sviluppo. */
  kind: "current" | "draft";
}

const { lang, kind } = Astro.props;
const { ui } = content[lang];
---

<span class:list={["badge", `badge--${kind}`]}>
  {kind === "current" && <span class="badge__dot" aria-hidden="true" />}
  {kind === "current" ? ui.current : ui.draft}
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 22px;
    padding: 0 var(--space-2);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1;
    white-space: nowrap;
  }

  .badge--current {
    color: var(--accent-text);
    background: var(--accent-soft);
  }

  .badge__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .badge--draft {
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    color: var(--text);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
