---
import Icon from "./Icon.astro";
import { content } from "../data";
import type { Lang } from "../data/types";

interface Props {
  lang: Lang;
  size?: "sm" | "md" | "lg";
  /** Versione corta per la barra: mostra solo "CV", il nome accessibile resta l'etichetta intera. */
  compact?: boolean;
}

const { lang, size = "md", compact = false } = Astro.props;
const { cv } = content[lang];
// Il PDF può essere in una lingua diversa dalla pagina (CV solo in italiano): in quel caso lo dichiariamo.
const hreflang = cv.hreflang !== lang ? cv.hreflang : undefined;
---

<a
  class:list={["btn", "btn--primary", size !== "md" && `btn--${size}`]}
  href={cv.href}
  download="Andrea_Turetta_CV.pdf"
  type="application/pdf"
  hreflang={hreflang}
  aria-label={compact ? cv.label : undefined}
>
  <Icon name="download" size={size === "sm" ? 16 : 18} />
  {compact ? "CV" : cv.label}
</a>
