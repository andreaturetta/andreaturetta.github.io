---
import CVButton from "./CVButton.astro";
import LangSwitch from "./LangSwitch.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { content, homePath } from "../data";
import type { Lang } from "../data/types";
import { homeContent } from "../lib/home";

interface Props {
  lang: Lang;
  altPath: string;
  isHome?: boolean;
}

const { lang, altPath, isHome = false } = Astro.props;
const c = content[lang];
const { sections } = homeContent(lang);
// Fuori dalla home le voci portano alle sezioni della home.
const base = isHome ? "" : homePath(lang);
---

<header class="bar" data-site-header>
  <div class="bar__inner">
    <a class="brand" href={isHome ? "#top" : homePath(lang)}>
      <span class="brand__mono" aria-hidden="true">AT</span>
      <span class="brand__name">{c.name}</span>
    </a>

    <nav class="nav" aria-label={c.ui.sectionsNav}>
      <ul class="nav__list">
        {
          sections.map((s) => (
            <li>
              <a class="nav__link" href={`${base}#${s.id}`}>
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <LangSwitch lang={lang} altPath={altPath} isHome={isHome} />
      <ThemeToggle lang={lang} />
      <CVButton lang={lang} size="sm" compact />
    </div>
  </div>
</header>

<style>
  /* Sfondo pieno, senza sfocatura: il testo che scorre sotto non deve trasparire. */
  .bar {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .bar__inner {
    max-width: calc(var(--content-max) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "brand actions"
      "nav nav";
    align-items: center;
    column-gap: var(--space-3);
  }

  .brand {
    grid-area: brand;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    height: 56px;
    border-radius: var(--radius);
    color: var(--text);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    transition: color 0.15s ease;
  }

  .brand:hover {
    color: var(--accent-text);
  }

  .brand__mono {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius);
    background: var(--text);
    color: var(--bg);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
    transition: background-color 0.15s ease;
  }

  .brand:hover .brand__mono {
    background: var(--accent-text);
  }

  /* Sugli schermi stretti il nome si nasconde alla vista ma resta il nome accessibile del link. */
  .brand__name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .nav {
    grid-area: nav;
    min-width: 0;
    margin-inline: calc(-1 * var(--gutter));
    border-top: 1px solid var(--border);
  }

  .nav__list {
    display: flex;
    gap: 2px;
    width: max-content;
    max-width: 100%;
    margin: 0;
    padding: var(--space-1) calc(var(--gutter) - 10px);
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .nav__list::-webkit-scrollbar {
    display: none;
  }

  .nav__list li {
    flex: none;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 10px;
    border-radius: var(--radius);
    color: var(--text-muted);
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .nav__link:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  .actions {
    grid-area: actions;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  @media (min-width: 640px) {
    .brand__name {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
    }
  }

  /* Da 880px la barra sta su una riga; sotto, le sezioni scorrono in una seconda riga. */
  @media (min-width: 880px) {
    .bar__inner {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas: "brand nav actions";
      column-gap: var(--space-4);
    }

    .brand {
      height: 64px;
    }

    .nav {
      margin-inline: 0;
      border-top: 0;
    }

    .nav__list {
      margin-inline: auto;
      padding: 0;
    }

    .nav__link {
      padding: 0 var(--space-2);
      font-size: 13.5px;
    }
  }

  @media (min-width: 880px) and (max-width: 1023.98px) {
    .brand__name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }
  }

  @media (min-width: 1200px) {
    .nav__link {
      padding: 0 var(--space-3);
      font-size: 14px;
    }
  }
</style>
