---
import CVButton from "./CVButton.astro";
import Icon from "./Icon.astro";
import { content } from "../data";
import type { Lang } from "../data/types";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = content[lang];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero__inner">
    <h1 id="hero-title" class="hero__name">{c.name}</h1>
    <p class="hero__title">{c.title}</p>
    <p class="status">
      <span class="status__dot" aria-hidden="true"></span>
      <span><span class="sr-only">{c.ui.currentStatus} </span>{c.status}</span>
    </p>
    <div class="hero__ctas">
      <CVButton lang={lang} size="lg" />
      <a class="btn btn--ghost btn--lg" href={`#${c.sections.contact.id}`}>
        {c.ui.contactMe}
        <span class="arrow"><Icon name="arrowRight" /></span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--space-20) 0 var(--space-16);
    border-bottom: 1px solid var(--border);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero__name {
    margin: 0;
    font-size: clamp(48px, 9vw, 88px);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.04em;
    color: var(--text);
    text-wrap: balance;
  }

  .hero__title {
    margin: var(--space-6) 0 0;
    max-width: 36ch;
    font-size: clamp(18px, 2.2vw, 24px);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--text-muted);
    text-wrap: balance;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    max-width: 100%;
    margin: var(--space-8) 0 0;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-muted);
    font-family: var(--mono);
    font-size: 12.5px;
    line-height: 1.4;
    text-align: left;
  }

  .status__dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .hero__ctas {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 100%;
    max-width: 320px;
    margin-top: var(--space-10);
  }

  .hero__ctas > :global(.btn) {
    width: 100%;
  }

  @media (min-width: 640px) {
    .hero__ctas {
      flex-direction: row;
      justify-content: center;
      width: auto;
      max-width: none;
    }

    .hero__ctas > :global(.btn) {
      width: auto;
    }
  }

  @media (min-width: 768px) {
    .hero {
      display: flex;
      align-items: center;
      min-height: clamp(560px, calc(100svh - 120px), 880px);
      padding: var(--space-24) 0;
    }

    .hero__inner {
      width: 100%;
    }
  }
</style>
