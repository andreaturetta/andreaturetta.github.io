---
import Icon from "./Icon.astro";
import { content, privacyPath } from "../data";
import type { Lang } from "../data/types";

interface Props {
  lang: Lang;
  /** Percorso della pagina corrente: segna il link all'informativa quando ci si trova già lì. */
  path: string;
}

const { lang, path } = Astro.props;
const c = content[lang];
const privacy = privacyPath(lang);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__inner">
    <p>© {year} {c.name}</p>
    <ul class="footer__links">
      <li>
        <a class="footer__link" href={privacy} aria-current={path === privacy ? "page" : undefined}>
          {c.ui.privacy}
        </a>
      </li>
      <li>
        <a class="footer__link" href="#top">
          {c.ui.backToTop}
          <Icon name="arrowUp" size={16} />
        </a>
      </li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--section-gap);
    padding: var(--space-8) 0 var(--space-10);
    border-top: 1px solid var(--border);
    font-size: 14px;
    color: var(--text-muted);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
  }

  .footer__inner p {
    margin: 0;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 32px;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    transition: color 0.15s ease;
  }

  .footer__link:hover {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
